# Application
APP_NAME=FinDocAnalyzer
APP_ENV=development
SECRET_KEY=your-secret-key-here

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=findoc_db
POSTGRES_USER=findoc_user
POSTGRES_PASSWORD=findoc_password
DATABASE_URL=postgresql://findoc_user:findoc_password@localhost:5432/findoc_db

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=financial_docs

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# CORS
CORS_ORIGINS=http://localhost:3000
